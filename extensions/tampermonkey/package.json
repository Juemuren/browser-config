{
  "name": "browser-export-userscripts",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:table": "vite --mode table",
    "dev:indexeddb": "vite --mode indexeddb",
    "dev:html": "vite --mode html",
    "build:table": "vite build --mode table",
    "build:indexeddb": "vite build --mode indexeddb",
    "build:html": "vite build --mode html",
    "build": "npm run build:table && npm run build:indexeddb && npm run build:html",
    "typecheck": "vue-tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check ."
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "tesseract.js": "^6.0.1",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-monkey": "^7.1.0",
    "vue-tsc": "^3.1.0"
  }
}
